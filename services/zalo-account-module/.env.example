# Supabase project shared with the main InvoiceFlow app.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# services/zalo-bridge base URL. Server-side proxy calls (/auth/accounts*,
# /auth/reconnect) use this.
ZALO_BRIDGE_URL=http://localhost:3001

# Browser-side bridge URL for the chat feature (send/receive messages, SSE) —
# the browser calls the bridge DIRECTLY, not through this Next.js server, so
# it needs a URL it can actually reach (never an internal Docker hostname —
# e.g. through nginx like https://timetech.markeeai.com/zalo-bridge in prod).
# Bridge's ALLOWED_ORIGINS must include this module's own origin (CORS).
NEXT_PUBLIC_ZALO_BRIDGE_URL=http://localhost:3001

# Optional. Sent as `x-api-key` header on every bridge request when set.
BRIDGE_API_KEY=

# Main InvoiceFlow app URL (used by /login-required to link back). This
# module has no login form of its own.
NEXT_PUBLIC_MAIN_APP_URL=https://timetech.markeeai.com

# Set to the shared parent domain (e.g. ".timetech.markeeai.com", leading
# dot) on the MAIN app's own .env for the current_staff_id cookie to be sent
# to this module's subdomain too — this module only reads the cookie, it
# never sets STAFF_COOKIE_DOMAIN itself.

