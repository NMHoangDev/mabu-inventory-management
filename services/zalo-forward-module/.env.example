# Supabase (đọc/ghi zalo_forward_rules/targets/logs/cursor + poll zalo_messages)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# zalo-bridge — nơi thực thi gửi thật qua endpoint /forward/{text,media,sticker}
ZALO_BRIDGE_URL=http://localhost:3001
BRIDGE_API_KEY=

# Browser-side bridge URL — dùng bởi nút "Đăng nhập lại" (extension import
# session cần biết backend_url mà TRÌNH DUYỆT gọi thẳng được, không phải
# hostname nội bộ Docker).
NEXT_PUBLIC_ZALO_BRIDGE_URL=http://localhost:3001

# App chính InvoiceFlow (dùng ở /login-required + link "back" trong dashboard).
# Module này không có login form riêng.
NEXT_PUBLIC_MAIN_APP_URL=https://timetech.markeeai.com

# Poller
FORWARD_DRY_RUN=true
FORWARD_POLL_INTERVAL_MS=3000
ZALO_FORWARD_DELAY_MS=10000
ZALO_FORWARD_MAX_PER_MIN=60
ZALO_FORWARD_IMAGE_BATCH_MS=3000
ZALO_FORWARD_IMAGE_BATCH_MAX_MS=8000
ZALO_FORWARD_TASK_TIMEOUT_MS=45000

PORT=3003
HOST=0.0.0.0
